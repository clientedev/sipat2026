# ==============================================================================
# SIPAT 2026 - ESCOLA SENAI "MORVAN FIGUEIREDO"
# Exemplo de Variáveis de Ambiente (.env.example)
# Copie para .env em desenvolvimento ou configure no painel do Railway em produção
# ==============================================================================

# Ambiente de execução: development | production | test
NODE_ENV=production

# Porta HTTP/WebSocket fornecida automaticamente pelo Railway (não fixe em produção)
PORT=3000

# URL pública da aplicação (usada para gerar links de QR Code e CORS)
# No Railway, utilize o domínio gerado (ex: https://sipat2026-production.up.railway.app)
PUBLIC_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# BANCO DE DADOS POSTGRESQL (Obrigatório - Railway PostgreSQL)
# No Railway: conecte usando ${{Postgres.DATABASE_URL}}
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sipat2026?schema=public"

# ------------------------------------------------------------------------------
# SEGURANÇA E SESSÃO (Obrigatório)
# Gere uma chave aleatória forte com pelo menos 32 caracteres:
# openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET="altere-este-segredo-para-uma-chave-forte-aleatoria-em-producao-2026"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE="true"

# ------------------------------------------------------------------------------
# PRIMEIRO SUPERADMINISTRADOR (Usado no seed inicial caso nenhum admin exista)
# Altere a senha imediatamente após o primeiro acesso em produção!
# ------------------------------------------------------------------------------
INITIAL_ADMIN_NAME="Coordenação SIPAT - SENAI Morvan Figueiredo"
INITIAL_ADMIN_EMAIL="admin.sipat@senai.br"
INITIAL_ADMIN_PASSWORD="Sipat@Senai2026!ChangeMe"

# Opcional: Conta inicial de Avaliador da CIPA / Docentes
INITIAL_EVALUATOR_NAME="Comissão Avaliadora CIPA / Docentes"
INITIAL_EVALUATOR_EMAIL="avaliador.sipat@senai.br"
INITIAL_EVALUATOR_PASSWORD="Avalia@Senai2026!ChangeMe"

# ------------------------------------------------------------------------------
# ARMAZENAMENTO EXTERNO DE OBJETOS S3-COMPATÍVEL (Recomendado/Obrigatório em Produção)
# Compatível com Cloudflare R2, AWS S3, Railway Storage Buckets, MinIO, Backblaze B2
# Evita armazenar fotos e vídeos no disco efêmero do container ou no PostgreSQL.
# ------------------------------------------------------------------------------
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="sipat2026-evidencias"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Forçar path-style (true para MinIO, false para R2 / AWS S3)
S3_FORCE_PATH_STYLE="false"
# Tempo de expiração (segundos) de URLs assinadas para evidências privadas (LGPD)
S3_SIGNED_URL_TTL="900"

# Limites de Upload (em MB)
MAX_IMAGE_SIZE_MB="10"
MAX_VIDEO_SIZE_MB="60"

# ------------------------------------------------------------------------------
# NOTIFICAÇÕES WEB PUSH OPCIONAIS (PWA - VAPID Keys)
# Gere com: npx web-push generate-vapid-keys
# Se deixado em branco, notificações internas em tempo real (WebSocket) continuam ativas
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:sipat.morvanfigueiredo@senai.br"

# ------------------------------------------------------------------------------
# POLÍTICA DE RETENÇÃO LGPD
# Quantidade padrão de dias para retenção de arquivos de mídia após o evento
# ------------------------------------------------------------------------------
LGPD_MEDIA_RETENTION_DAYS="90"
